# NovelForge local Compose configuration
NOVELFORGE_BIND_HOST=127.0.0.1
DEBUG=false
AUTH_ENABLED=false

# Non-loopback exposure requires AUTH_ENABLED=true and DEBUG=false. Keep this
# override false unless an isolated trusted network has separate protection.
ALLOW_INSECURE_NETWORK_EXPOSURE=false

# Generate long random tokens. Never commit real tokens.
# Example when AUTH_ENABLED=true:
# AUTH_TOKENS_JSON={"replace-with-at-least-16-random-characters":{"user_id":"author-1","roles":["user"]},"replace-with-a-separate-admin-token":{"user_id":"operator","roles":["admin"]}}
AUTH_TOKENS_JSON={}

# Plugin manifests are mounted read-only. Enabled IDs must be an exact JSON
# allow-list. Code execution remains disabled unless explicitly enabled with a
# Manifest v2 integrity digest and matching permission grants.
PLUGIN_ROOT=/app/plugins
PLUGIN_ENABLED_JSON=[]
PLUGIN_EXECUTION_ENABLED=false
PLUGIN_PERMISSION_GRANTS_JSON={}
