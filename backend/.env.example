APP_NAME=NovelForge

DEBUG=true

API_VERSION=v1

# Local chat provider (Ollama OpenAI-compatible endpoint).
QWEN_BASE_URL=http://ollama:11434
QWEN_MODEL=qwen3:8b

# Optional cloud provider. Leave the key empty to keep DeepSeek unconfigured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
