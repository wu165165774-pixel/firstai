APP_NAME=NovelForge

DEBUG=true

API_VERSION=v1

# Local chat provider (Ollama OpenAI-compatible endpoint).
QWEN_BASE_URL=http://ollama:11434
QWEN_MODEL=qwen3:8b

# Optional cloud provider. Leave the key empty to keep DeepSeek unconfigured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Optional Anthropic Claude provider.
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=4096

# Optional Alibaba Cloud Model Studio provider (Beijing region).
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
